      "sourceURL": "https://www.hasil.gov.my/individu/pelepasan-cukai/" },

    { "code": "DISABLED_EQUIPMENT",
      "name": "Basic supporting equipment for a disabled self, spouse, child or parent",
      "cap": { "kind": "fixed", "sen": 600000 },
